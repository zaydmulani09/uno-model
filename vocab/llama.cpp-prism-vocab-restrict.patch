+++ b/src/models/qwen3.cpp
@@ -12,7 +12,7 @@ void llama_model_qwen3::load_arch_hparams(llama_model_loader & ml) {
     }
 }
 
-void llama_model_qwen3::load_arch_tensors(llama_model_loader &) {
+void llama_model_qwen3::load_arch_tensors(llama_model_loader & ml) {
     LLAMA_LOAD_LOCALS;
 
     tok_embd = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, 0);
@@ -25,6 +25,14 @@ void llama_model_qwen3::load_arch_tensors(llama_model_loader &) {
         output = create_tensor(tn(LLM_TENSOR_TOKEN_EMBD, "weight"), {n_embd, n_vocab}, TENSOR_DUPLICATED);
     }
 
+    // restricted LM head, present only in GGUFs written by uno-model's vocab/restrict.py
+    if (const ggml_tensor * meta = ml.get_tensor_meta(tn(LLM_TENSOR_OUTPUT_SUB, "weight").str().c_str())) {
+        const int64_t n_sub = meta->ne[1];
+        output_sub     = create_tensor(tn(LLM_TENSOR_OUTPUT_SUB,     "weight"), {n_embd, n_sub}, 0);
+        output_sub_b   = create_tensor(tn(LLM_TENSOR_OUTPUT_SUB,     "bias"),   {n_sub},         0);
+        output_sub_map = create_tensor(tn(LLM_TENSOR_OUTPUT_SUB_MAP, "weight"), {n_vocab},       0);
+    }
+
     // output rerank head
     cls_out = create_tensor(tn(LLM_TENSOR_CLS_OUT, "weight"), {n_embd, hparams.n_cls_out}, TENSOR_NOT_REQUIRED);
 
@@ -149,8 +157,17 @@ llama_model_qwen3::graph::graph(const llama_model & model, const llm_graph_param
     cb(cur, "result_norm", -1);
     res->t_embd = cur;
 
-    // lm_head
-    cur = build_lora_mm(model.output, cur, model.output_s);
+    const auto & m = static_cast<const llama_model_qwen3 &>(model);
+    if (m.output_sub) {
+        // lm_head over the vocab subset only: [n_sub, n_outputs], -inf in the padding row
+        cur = ggml_add(ctx0, ggml_mul_mat(ctx0, m.output_sub, cur), m.output_sub_b);
+        // scatter back to the full vocab: gather rows of the transposed logits by token
+        cur = ggml_get_rows(ctx0, ggml_cont(ctx0, ggml_transpose(ctx0, cur)), m.output_sub_map);
+        cur = ggml_cont(ctx0, ggml_transpose(ctx0, cur)); // [n_vocab, n_outputs]
+    } else {
+        // lm_head
+        cur = build_lora_mm(model.output, cur, model.output_s);
+    }
 
     cb(cur, "result_output", -1);
     res->t_logits = cur;
