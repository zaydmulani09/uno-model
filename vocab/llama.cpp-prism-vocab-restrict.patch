     void load_arch_hparams(llama_model_loader & ml) override;
     void load_arch_tensors(llama_model_loader & ml) override;
 
+    // optional restricted LM head (uno-model): output_sub holds K selected vocab rows plus one
+    // zero row, output_sub.bias is 0 for those K rows and -inf for the zero row, and
+    // output_sub_map[token] is the row of that token (K for tokens outside the subset)
+    ggml_tensor * output_sub     = nullptr;
+    ggml_tensor * output_sub_b   = nullptr;
+    ggml_tensor * output_sub_map = nullptr;
+
     struct graph : public llm_graph_context {
         graph(const llama_model & model, const llm_graph_params & params);
     };
